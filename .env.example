# URL do SIGO Obras
SIGO_URL=https://sigoobras2.mocha.app

# Porta do servidor local
PORT=3000

# Habilitar logs detalhados
DEBUG=true

# Mensagem de boas-vindas personalizada (opcional)
WELCOME_MESSAGE=Olá! Envie fotos ou PDFs de notas fiscais e elas serão processadas automaticamente no SIGO Obras.

# Mensagem de sucesso (opcional)
SUCCESS_MESSAGE=✅ Documento recebido com sucesso! Acesse o SIGO Obras para revisar e aprovar.

# Mensagem de erro (opcional)
ERROR_MESSAGE=❌ Erro ao processar documento. Verifique se seu telefone está cadastrado no sistema.
